# === Banco de dados ===
POSTGRES_USER=devflow
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=devflow

# === Segurança ===
# Gere com: openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Storage S3 ===
MINIO_ACCESS_KEY=troque-por-uma-chave
MINIO_SECRET_KEY=troque-por-um-segredo
MINIO_BUCKET_NAME=devflow-uploads

# === IA ===
# Provedor: groq (gratuito) | openai | ollama | openrouter | gemini
AI_PROVIDER=groq
# Chave do Groq: https://console.groq.com/keys
AI_API_KEY=gsk_...
# Deixe vazio para usar o padrão do provedor
AI_MODEL=
AI_BASE_URL=
# Legado (apenas para AI_PROVIDER=openai)
OPENAI_API_KEY=

# === Frontend ===
# URL pública onde a API estará acessível
NEXT_PUBLIC_API_URL=https://api.seudominio.com
