# Application
APP_NAME=DevFlow
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg2://devflow:devflow@postgres:5432/devflow

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:5000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=devflow-uploads
MINIO_USE_SSL=false

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# IA — provedor: openai | groq | ollama | openrouter | gemini
# Groq (gratuito): crie a chave em https://console.groq.com/keys
AI_PROVIDER=groq
AI_API_KEY=gsk_...
# Deixe AI_MODEL e AI_BASE_URL vazios para usar o padrão do provedor
AI_MODEL=
AI_BASE_URL=

# Legado (usado apenas quando AI_PROVIDER=openai e AI_API_KEY está vazio)
OPENAI_API_KEY=
